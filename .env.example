# Vapi Custom TTS Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Authentication ────────────────────────────────────────────────────────────
# Secret token sent by Vapi in the X-Vapi-Secret header.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SECRET=REPLACE_WITH_YOUR_STRONG_SECRET

# ── Voice profile → Vapi assistant ID mapping ─────────────────────────────────
# Map your Vapi assistant IDs to approved voice profiles.
# Format: VAPI_ASSISTANT_ID_<PROFILE_ID>=<vapi-assistant-id>
# Example:
VAPI_ASSISTANT_ID_CLIENT_DEFAULT=REPLACE_WITH_YOUR_VAPI_ASSISTANT_ID

# ── Server settings ───────────────────────────────────────────────────────────
# Host and port for the FastAPI server
TTS_HOST=127.0.0.1
TTS_PORT=8000

# ── TTS model settings ────────────────────────────────────────────────────────
# Device: "cpu" (required on this machine — no NVIDIA GPU)
TTS_DEVICE=cpu

# ── Concurrency and queue ─────────────────────────────────────────────────────
TTS_MAX_CONCURRENT=1
TTS_QUEUE_SIZE=4
TTS_REQUEST_TIMEOUT=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
